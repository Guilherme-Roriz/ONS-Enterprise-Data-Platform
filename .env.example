# Copy this file to .env, replace the placeholder values, and never commit it.

# Direct Python execution from the host uses this address.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ons_edp

# Use a dedicated, non-superuser PostgreSQL role.
# The role name is configurable, but it must already exist and have the
# required access to the oltp, data_vault, galaxy, and etl schemas.
DB_USER=etl_user
DB_PASSWORD=change_me

# Docker Compose maps this value to DB_HOST inside the ETL containers.
# Keep host.docker.internal while PostgreSQL runs on the host machine.
# When PostgreSQL becomes a Compose service, use its service name instead.
DOCKER_DB_HOST=host.docker.internal

# Optional Data Vault -> Galaxy calendar horizon.
GALAXY_START_DATE=2000-01-01
GALAXY_END_DATE=2050-12-31
LOG_LEVEL=INFO
