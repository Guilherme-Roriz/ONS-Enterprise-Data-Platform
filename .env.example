# Copy this file to .env, replace the placeholder values, and never commit it.

# PostgreSQL container administrator. These credentials are used only by the
# database container during initialization and are not passed to Python jobs.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_admin_password
POSTGRES_PORT=5432

# Database and least-privilege application roles.
DB_NAME=ons_edp
DB_USER=etl_user
DB_PASSWORD=change_etl_password
OLTP_USER=oltp_loader
OLTP_PASSWORD=change_oltp_password

# Direct Python execution from the host uses the published PostgreSQL port.
DB_HOST=localhost
DB_PORT=5432

# Containers reach PostgreSQL through its Compose service name and internal port.
DOCKER_DB_HOST=postgres

# Optional Data Vault -> Galaxy calendar horizon.
GALAXY_START_DATE=2000-01-01
GALAXY_END_DATE=2050-12-31
LOG_LEVEL=INFO
